---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const projects = [
 {kind:'CAPSTONE THESIS / HARDWARE AUTOMATION',title:'Automated Waterjet Tile Cutting Machine',status:'SPEC: REV-3.4',description:'A computer-controlled cutting system designed to reduce manual alignment errors, improve cutting precision, and make operator workflows safer.',tags:['C/C++','Microcontrollers','Motor Control','Sensor Integration'],accent:'sky',video:'https://photos.app.goo.gl/xT8aGFUJop51rpgs9'},
 {kind:'NETWORKING / FIELD ENGINEERING',title:'Enterprise Wi-Fi Deployment Systems',status:'FIELD: 2024—2026',description:'Deployed access points and structured cabling across government facilities, configuring VLANs, captive portals, and signal coverage in line with DICT standards.',tags:['Network Design','VLANs','Site Surveys','Signal Testing'],accent:'mint',images:[{src:'/dict-free-wifi-1.png',alt:'DICT Free WiFi deployment team in Panabo City'},{src:'/dict-free-wifi-2.png',alt:'DICT Free WiFi deployment at A. Pichon Street'},{src:'/dict-free-wifi-3.png',alt:'DICT Free WiFi deployment at F. Iñigo Street'}]},
 {kind:'WEB DEVELOPMENT / PERSONAL SYSTEMS',title:'Kharland’s Engineering Log',status:'STATUS: BUILDING',description:'A fast, documentation-first portfolio and blog for sharing practical notes on software, hardware, networks, and the systems behind them.',tags:['Astro','TypeScript','Web Development','Technical Writing'],accent:'lavender',href:'https://github.com/stup1nd4s/portfolio_Kharland'},
 {kind:'MACHINE LEARNING / FLUTTER MOBILE',title:'Kharo-Can Leafcare',status:'PROJECT: LEAFCARE',description:'A Flutter mobile app for leafcare and plant detection, powered by the YOLOv8 algorithm and RF-DETR NAS model.',tags:['Flutter','Machine Learning','YOLOv8','RF-DETR NAS'],accent:'mint',href:'https://github.com/stup1nd4s/KharoCan_LeafCare'}
];
const skills = [
 {title:'Software & Web',icon:'&#8984;',copy:'Practical software development with a focus on useful, maintainable interfaces.',items:['Java','Python','Web Development','Digital Fluency']},
 {title:'Infrastructure',icon:'&#9670;',copy:'Hands-on deployment, configuration, troubleshooting, and field validation.',items:['Server Configuration','Network Hardware','Structured Cabling','Site Surveys']},
 {title:'Professional Systems',icon:'&#9678;',copy:'Clear communication and organized workflows across technical and support roles.',items:['Technical Documentation','Email Etiquette','Customer Support','Microsoft Excel']}
];
---
<!doctype html><html lang="en"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /><script is:inline>const savedTheme = localStorage.getItem('theme'); if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.dataset.theme = 'dark';</script></head><body>
<header class="site-header"><div class="shell nav-wrap"><a class="brand" href="/"><span></span> KHARLAND QUIZA // CPE</a><nav><a class="active" href="#projects">Projects</a><a href="#about">About</a><a href="#resume">Resume</a><a href="#contact">Contact</a></nav><div class="nav-actions"><a class="icon-link" href="#contact">&gt;_</a><a class="icon-link" href="https://github.com">&#8984;</a><button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false"><span aria-hidden="true">&#9790;</span></button></div></div></header>
<main class="shell"><section class="hero grid-pattern" id="about"><div class="hero-copy"><div class="availability"><i></i> AVAILABLE FOR SOFTWARE &amp; HARDWARE ENGINEERING ROLES</div><h1>Hi, I’m Kharland Quiza — Computer Engineer &amp; Systems Builder.</h1><p class="lede">I work at the intersection of software, networks, and hardware—turning technical requirements into systems that are useful, reliable, and easy to understand.</p><div class="hero-actions"><a class="button button-dark" href="/Resume-Kharland.pdf" download>Download Resume <span>&darr;</span></a><a class="button button-light" href="https://mail.google.com/mail/?view=cm&fs=1&to=kharlandq%40gmail.com&su=Portfolio%20inquiry" target="_blank" rel="noreferrer">Email Me <span>&nearr;</span></a><div class="socials"><a href="https://github.com">GitHub &nearr;</a><a href="https://linkedin.com">LinkedIn &nearr;</a></div></div><div class="facts"><div><small>FOCUS</small><strong>Software, networks &amp; hardware</strong></div><div><small>EDUCATION</small><strong>BS Computer Engineering</strong></div><div><small>BASE</small><strong>Calinan, Davao City</strong></div></div></div></section>
<section class="section" id="projects"><div class="section-heading"><div><small>01 // FEATURED WORK</small><h2>Selected Engineering Projects</h2></div><small>4 ENTRIES CATALOGUED</small></div><div class="project-list">{projects.map((project) => <article class:list={['card','project-card',project.accent]}><div class="project-top"><div><span class="tag">{project.kind}</span><h3>{project.title}</h3></div><small>{project.status}</small></div><p>{project.description}</p>{project.video && <a class='video-link' href={project.video} target='_blank' rel='noreferrer'>Watch machine demo <b>&nearr;</b></a>}{project.images && <div class="project-gallery">{project.images.map((image) => <img src={image.src} alt={image.alt} loading="lazy" />)}</div>}<div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div><div class="card-footer"><a href={project.href ?? '#contact'} target={project.href ? '_blank' : undefined} rel={project.href ? 'noreferrer' : undefined}>View project repository <b>&rarr;</b></a><span>CASE STUDY &nearr;</span></div></article>)}</div></section>
<section class="section" id="resume"><div class="section-heading"><div><small>02 // CAPABILITIES</small><h2>Technical Architecture &amp; Core Competencies</h2></div></div><div class="skills-grid">{skills.map((skill) => <article class="card skill-card"><div class="skill-title"><span set:html={skill.icon}></span><h3>{skill.title}</h3></div><p>{skill.copy}</p><ul>{skill.items.map((item) => <li><span>{item}</span><small>APPLIED</small></li>)}</ul></article>)}</div></section>
<section class="section history-grid"><div><div class="section-heading compact"><div><small>03 // EXPERIENCE</small><h2>Work History</h2></div></div><div class="timeline"><div><small>2024—2026</small><h3>Lumetri Tech</h3><strong>Tech Engineer</strong><p>Deployed enterprise Wi-Fi equipment, access points, and structured cabling across government facilities.</p></div><div><small>2021—2022</small><h3>Concentrix</h3><strong>Chat Agent</strong><p>Resolved customer inquiries and troubleshooting requests through live chat.</p></div><div><small>2019—2021</small><h3>Virtual Professionals</h3><strong>Virtual Assistant</strong><p>Supported real estate operations through scheduling, listings, client inquiries, and document management.</p></div></div></div><div><div class="section-heading compact"><div><small>04 // EDUCATION</small><h2>Learning Systems</h2></div></div><div class="education card"><small>2022—CURRENT</small><h3>BS in Computer Engineering</h3><p>University of Immaculate Conception</p><hr /><small>2017—2019</small><h3>High School Diploma</h3><p>Holycross College of Calinan</p></div></div></section>
<section class="contact card" id="contact"><div><small>GET IN TOUCH</small><h2>Ready to build useful systems together?</h2><p>Reach out for engineering roles, technical collaboration, or a conversation about software and infrastructure.</p></div><a class="button button-dark" href="https://mail.google.com/mail/?view=cm&fs=1&to=kharlandq%40gmail.com&su=Portfolio%20inquiry" target="_blank" rel="noreferrer">kharlandq@gmail.com <span>&nearr;</span></a></section></main>
<footer><div class="shell footer-wrap"><strong>KHARLAND QUIZA // CPE</strong><span>© 2026 Kharland Quiza</span><div><a href="https://github.com">GitHub</a><a href="https://linkedin.com">LinkedIn</a><a href="https://mail.google.com/mail/?view=cm&fs=1&to=kharlandq%40gmail.com&su=Portfolio%20inquiry" target="_blank" rel="noreferrer">Email</a></div></div></footer><script is:inline>const toggle = document.querySelector('.theme-toggle'); const updateThemeButton = () => { const dark = document.documentElement.dataset.theme === 'dark'; toggle?.setAttribute('aria-pressed', String(dark)); toggle?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode'); if (toggle) toggle.innerHTML = dark ? '<span aria-hidden="true">&#9728;</span>' : '<span aria-hidden="true">&#9790;</span>'; }; updateThemeButton(); toggle?.addEventListener('click', () => { const dark = document.documentElement.dataset.theme !== 'dark'; document.documentElement.dataset.theme = dark ? 'dark' : 'light'; localStorage.setItem('theme', dark ? 'dark' : 'light'); updateThemeButton(); });</script></body></html>
